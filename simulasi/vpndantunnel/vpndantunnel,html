<div class="footer">SIMULASI PEMBELAJARAN WAN • TKJ PERSIAPAN</div>

<script>
(()=>{
 const root=document.getElementById('wan-vpn-lab');
 if(!root || root.dataset.ready==='1') return;
 root.dataset.ready='1';
 const $=id=>root.querySelector('#'+id);
 const slides=[...root.querySelectorAll('.slide')];
 let current=0;
 function showSlide(n){
  current=Math.max(0,Math.min(slides.length-1,n));
  slides.forEach((s,i)=>s.classList.toggle('active',i===current));
  $('vpnCounter').textContent=`Bagian ${current+1} dari ${slides.length}`;
  $('vpnProgress').style.width=((current+1)/slides.length*100)+'%';
  $('vpnPrev').disabled=current===0;
  $('vpnNext').textContent=current===slides.length-1?'Kembali ke awal ↺':'Berikutnya →';
 }
 $('vpnPrev').addEventListener('click',()=>showSlide(current-1));
 $('vpnNext').addEventListener('click',()=>showSlide(current===slides.length-1?0:current+1));

 // Need VPN decision
 const needInfo={
  yes:'VPN dapat menjadi solusi yang tepat. Akses ke jaringan privat atau komunikasi antarlokasi dapat dilindungi dengan autentikasi dan enkripsi, sesuai kebutuhan serta konfigurasi.',
  no:'Untuk membuka situs publik biasa, VPN tidak selalu diperlukan. VPN dapat digunakan karena alasan keamanan atau kebijakan tertentu, tetapi bukan syarat untuk mengakses setiap situs.'
 };
 root.querySelectorAll('#vpnNeedChoices button').forEach(btn=>{
  btn.addEventListener('click',()=>{
   root.querySelectorAll('#vpnNeedChoices button').forEach(b=>b.classList.remove('selected'));
   btn.classList.add('selected');
   $('vpnNeedResult').innerHTML='<p>'+needInfo[btn.dataset.answer]+'</p>';
  });
 });

 // Device roles
 const deviceInfo={
  router:['Router VPN','Membentuk tunnel dan menghubungkan jaringan lokal dengan jaringan di lokasi lain. Contohnya router di kantor pusat dan cabang.'],
  server:['Server VPN','Menjalankan layanan VPN, mengelola koneksi pengguna, serta memverifikasi autentikasi sesuai konfigurasi.'],
  client:['VPN Client','Aplikasi atau fitur pada laptop dan ponsel yang digunakan untuk terhubung ke server atau gateway VPN.'],
  firewall:['Firewall','Mengatur lalu lintas yang boleh masuk dan keluar, termasuk membatasi akses pengguna VPN ke jaringan internal.']
 };
 root.querySelectorAll('#vpnDeviceChoices button').forEach(btn=>{
  btn.addEventListener('click',()=>{
   root.querySelectorAll('#vpnDeviceChoices button').forEach(b=>b.classList.remove('selected'));
   btn.classList.add('selected');
   const d=deviceInfo[btn.dataset.device];
   $('vpnDeviceInfo').innerHTML='<h3 class="teal-text">'+d[0]+'</h3><p>'+d[1]+'</p>';
  });
 });

 // Protocol details
 const protocolInfo={
  wg:['WireGuard','Cocok untuk koneksi modern yang relatif sederhana. Menggunakan pasangan public key dan private key. Administrator perlu mengatur peer, alamat tunnel, endpoint, serta jaringan yang diizinkan.'],
  ipsec:['IPsec','Sering digunakan untuk menghubungkan jaringan kantor. Konfigurasi umumnya melibatkan peer, autentikasi, algoritma keamanan, parameter pertukaran kunci, serta kebijakan trafik.'],
  ovpn:['OpenVPN','Banyak digunakan untuk akses jarak jauh. Membutuhkan server, sertifikat atau metode autentikasi yang sesuai, profil client, dan aturan routing serta firewall.']
 };
 root.querySelectorAll('#vpnProtocolChoices button').forEach(btn=>{
  btn.addEventListener('click',()=>{
   root.querySelectorAll('#vpnProtocolChoices button').forEach(b=>b.classList.remove('selected'));
   btn.classList.add('selected');
   const p=protocolInfo[btn.dataset.protocol];
   $('vpnProtocolInfo').innerHTML='<h3 class="teal-text">'+p[0]+'</h3><p>'+p[1]+'</p>';
  });
 });

 // VPN tunnel simulator
 let tunnelOn=false;
 function setTunnel(on){
  tunnelOn=on;
  $('vpnToggle').classList.toggle('on',on);
  $('vpnStatus').textContent=on?'CONNECTED':'DISCONNECTED';
  $('vpnStatus').classList.toggle('on',on);
  $('vpnTunnelSvgStatus').textContent=on?'TUNNEL AKTIF':'BELUM AKTIF';
  $('vpnTunnelPath').setAttribute('stroke',on?'#2dd4bf':'#77638e');
  $('vpnTunnelPath').setAttribute('stroke-dasharray',on?'5 5':'7 7');
  $('vpnPingOutput').textContent=on
   ?'Tunnel berhasil dibentuk pada simulasi.\nJaringan A dan B siap diuji.\nCatatan: status ini hanya simulasi konsep.'
   :'Tunnel belum aktif.\nAktifkan VPN sebelum menjalankan ping.';
 }
 $('vpnToggle').addEventListener('click',()=>setTunnel(!tunnelOn));
 $('vpnPing').addEventListener('click',()=>{
  $('vpnPingOutput').textContent=tunnelOn
   ?'PING 192.168.20.10 dari 192.168.10.10\nReply: simulasi paket berhasil melewati VPN tunnel.\nStatus: SUCCESS (SIMULASI)\n\nKoneksi nyata tetap membutuhkan routing, firewall, dan konfigurasi kedua sisi yang benar.'
   :'PING 192.168.20.10 dari 192.168.10.10\nRequest timed out.\nStatus: FAILED\nPenyebab pada simulasi: VPN tunnel belum aktif.';
 });

 // Quiz
 const questions=[
  {q:'Apa kepanjangan VPN?',o:['Virtual Private Network','Visual Protocol Node','Variable Public Network','Virtual Program Number'],a:0,e:'VPN adalah Virtual Private Network, yaitu jaringan privat virtual.'},
  {q:'Apa analogi paling tepat untuk VPN tunnel?',o:['Jalan raya tanpa aturan','Terowongan khusus di atas jalan umum','Kabel listrik rumah','Antena pemancar radio'],a:1,e:'VPN tunnel seperti terowongan logis yang membawa komunikasi melalui jaringan perantara.'},
  {q:'VPN Site-to-Site umumnya digunakan untuk...',o:['Menghubungkan dua jaringan kantor','Mengganti sistem operasi','Mempercepat semua situs web','Menghubungkan keyboard ke komputer'],a:0,e:'Site-to-Site menghubungkan jaringan di lokasi berbeda, misalnya kantor pusat dan cabang.'},
  {q:'Di mana VPN dapat dikonfigurasi?',o:['Hanya di komputer','Hanya di ponsel','Router, firewall, server, atau perangkat client','Hanya di switch biasa'],a:2,e:'Lokasi konfigurasi bergantung pada arsitektur VPN. Bisa di router, firewall, server, cloud, atau client.'},
  {q:'Mengapa ping antarlokasi bisa gagal meskipun tunnel VPN aktif?',o:['Karena VPN tidak bisa membawa data','Karena routing atau firewall belum benar','Karena semua VPN wajib menggunakan satelit','Karena IP address tidak dibutuhkan'],a:1,e:'Tunnel aktif saja tidak cukup. Routing, firewall, subnet yang diizinkan, dan konfigurasi kedua sisi harus sesuai.'}
 ];
 let qIndex=0,score=0,answered=false;
 function renderQuestion(){
  const q=questions[qIndex];answered=false;
  $('vpnQuizCount').textContent=`Pertanyaan ${qIndex+1} dari ${questions.length}`;
  $('vpnQuestion').textContent=q.q;
  $('vpnOptions').innerHTML='';
  $('vpnFeedback').classList.remove('show');
  $('vpnFeedback').textContent='';
  $('vpnQuizNext').disabled=true;
  q.o.forEach((opt,i)=>{
   const b=document.createElement('button');
   b.className='quiz-option';b.textContent=String.fromCharCode(65+i)+'. '+opt;
   b.addEventListener('click',()=>{
    if(answered)return;
    answered=true;
    const buttons=[...$('vpnOptions').children];
    buttons.forEach((x,j)=>{
     x.disabled=true;
     if(j===q.a)x.classList.add('correct');
    });
    if(i===q.a)score++;
    else b.classList.add('wrong');
    $('vpnScore').textContent='Skor: '+score;
    $('vpnFeedback').textContent=(i===q.a?'Benar! ':'Belum tepat. ')+q.e;
    $('vpnFeedback').classList.add('show');
    $('vpnQuizNext').disabled=false;
    $('vpnQuizNext').textContent=qIndex===questions.length-1?'Lihat Hasil':'Berikutnya →';
   });
   $('vpnOptions').appendChild(b);
  });
 }
 $('vpnQuizNext').addEventListener('click',()=>{
  if(!answered)return;
  if(qIndex<questions.length-1){qIndex++;renderQuestion();}
  else{
   $('vpnQuiz').style.display='none';
   $('vpnQuizResult').style.display='block';
   $('vpnFinalScore').textContent=score+'/'+questions.length;
   $('vpnFinalMessage').textContent=score===5?'Luar biasa! Semua jawaban benar.':score>=3?'Bagus! Pelajari kembali bagian yang belum dikuasai.':'Ayo pelajari kembali materi VPN dan coba sekali lagi.';
  }
 });
 $('vpnRestart').addEventListener('click',()=>{
  qIndex=0;score=0;
  $('vpnScore').textContent='Skor: 0';
  $('vpnQuiz').style.display='block';
  $('vpnQuizResult').style.display='none';
  $('vpnQuizNext').textContent='Berikutnya →';
  renderQuestion();
 });
 renderQuestion();
 showSlide(0);
})();
</script>
</div>
